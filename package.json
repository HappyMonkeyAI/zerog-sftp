{
  "name": "zerog-sftp",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone SFTP file transfer client for Windows and OpenSSH",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-preload.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "react": "^19.1.1", "react-dom": "^19.1.1" },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
